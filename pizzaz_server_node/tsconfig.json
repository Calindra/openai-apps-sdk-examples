{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "eitri-bifrost": [
        "./src/eitri-bifrost-substitute.ts",
        "./dist/lambda/eitri-bifrost-substitute.js"
      ]
    },
  },
  "include": [
    "./src/**/*.ts"
  ]
}